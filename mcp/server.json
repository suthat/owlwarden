{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.suthat/owlwarden",
  "description": "Read-only, offline security checks for Node web apps and coding-agent configuration.",
  "repository": {
    "url": "https://github.com/suthat/owlwarden",
    "source": "github"
  },
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "owlwarden",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
